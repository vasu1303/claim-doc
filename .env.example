# Run npm run setup to generate strong local secrets and the initial admin password.
JWT_SECRET=
SERVICE_TOKEN=
ADMIN_EMAIL=admin@locker.test
ADMIN_PASSWORD=

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
AI_PORT=8001
MESSENGER_PORT=8002
AI_SERVICE_URL=http://127.0.0.1:8001
MESSENGER_URL=http://127.0.0.1:8002

# Default: persistent embedded PostgreSQL in data/postgres, no server or Docker.
# Set DATABASE_URL to use a separately installed PostgreSQL server instead.
DATABASE_URL=
# PGLITE_DIR=
# STORAGE_DIR=
FILE_STORAGE=local
# For optional private S3/MinIO storage:
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=patient-docs
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# demo: explicitly labelled synthetic fixtures, no external calls.
# openai: unseen synthetic query letters and OCR, requires API key.
ANALYSIS_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXTERNAL_DATA_MODE=synthetic

# mock is explicitly labelled in the portal; it does NOT send to a phone or inbox.
# Change to live after configuring both providers and explicit test recipients.
DELIVERY_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_NUMBER=
WHATSAPP_API_VERSION=v22.0
# Outside the 24-hour conversation window, use an approved template whose body
# has a single {{1}} parameter containing the complete generated message.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_TO=
# MESSAGE_TEMPLATE_PATH=
